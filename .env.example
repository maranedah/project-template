# ---------------------------------------------------------------------------
# PROJECT_NAME configuration. Copy to `.env` and fill in secrets.
# Read by pydantic-settings with the APP_ prefix (backend/app/settings.py) and by
# docker-compose.yml / Makefile for port mapping.
# SSOT for env variables — docs link here and never restate values.
# ---------------------------------------------------------------------------

# Core
APP_ENV=local
APP_LOG_LEVEL=INFO

# Ports (host side). Incremental per project (+10), never the defaults 8000/3000 —
# other projects are likely using those. See .claude/INIT.md step 3.
APP_BACKEND_PORT=8100
APP_FRONTEND_PORT=3100
APP_DB_PORT=5532

# Database. App and Alembic URLs are kept separate so an async driver can swap into
# the app without touching migrations. Host is `db` inside compose; from the host
# use localhost:${APP_DB_PORT}.
APP_DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
APP_DATABASE_SYNC_URL=postgresql+psycopg://app:app@db:5432/app

# Worker (used only when the worker service is enabled in docker-compose.yml)
APP_WORKER_ID=worker-local
APP_WORKER_POLL_INTERVAL=2.0
APP_JOB_LEASE_SECONDS=300
APP_JOB_MAX_ATTEMPTS=3

# Storage. local | gcs
APP_STORAGE_BACKEND=local
APP_STORAGE_LOCAL_ROOT=var/storage
# APP_GCS_BUCKET=                # required when APP_STORAGE_BACKEND=gcs

# Connectors — one block per external API; register each one in
# docs/03-technical/01-project-organization/02-connectors.md
# APP_EXAMPLE_API_KEY=           # SECRET

# E2E (keep E2E_BASE_URL port in sync with APP_FRONTEND_PORT)
E2E_BASE_URL=http://localhost:3100
E2E_HEADLESS=1

# Compose-only: postgres container credentials (must match APP_DATABASE_URL)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
